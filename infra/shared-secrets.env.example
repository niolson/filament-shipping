# Shared Secrets — injected into all tenant app containers at runtime
# Copy to /opt/shared/shared-secrets.env and fill in values before provisioning tenants.
#
# These secrets are NOT written into individual tenant .env files.
# To rotate any of them: update this file and restart all tenant containers.
#   docker compose --all-projects up -d   (or deploy-tenant.sh --all)
#
# REDIS_PASSWORD must match the value in /opt/shared/.env (used by shared-redis).

REDIS_PASSWORD=

# Google SSO — register the OAuth app once; all tenants share the same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth broker shared secret — must match SHARED_TENANT_SECRET in /opt/polybag-connect/.env.
OAUTH_BROKER_SECRET=

# Resend — transactional email (MFA codes, etc.). One account/domain
# (updates.polybag.app) for all tenants.
RESEND_API_KEY=
