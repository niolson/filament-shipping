# Shared Infrastructure Credentials
# Copy to /opt/shared/.env and fill in before starting:
#   cp .env.example .env
#
# Also copy shared-secrets.env.example to /opt/shared/shared-secrets.env — that file
# holds the secrets injected into tenant app containers at runtime (Redis password,
# Google SSO, OAuth broker secret). REDIS_PASSWORD must be the same in both files.

MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
