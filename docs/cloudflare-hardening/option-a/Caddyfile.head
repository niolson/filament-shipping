# ============================================================================
#  Cloudflare hardening — global options + shared snippet.
#  Put this block at the TOP of /opt/caddy/Caddyfile (above the tenant blocks
#  that provision-tenant.sh appends). The provisioning script only ever appends,
#  so it will never clobber this header.
# ============================================================================

{
	# --- Restore the real client IP behind Cloudflare ---------------------
	# Caddy is the edge here (nginx only ever sees Caddy). We trust ONLY the
	# Cloudflare ranges and read the real visitor from CF-Connecting-IP.
	# `trusted_proxies_strict` means forwarded headers from anyone NOT in this
	# list are ignored — so a direct hit to the origin can't spoof an IP.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
		trusted_proxies_strict
	}
}

# --- Per-tenant origin hardening (imported by every vhost) ------------------
# Wildcard Origin CA cert + Authenticated Origin Pulls (custom cert).
# The same *.polybag.app cert/key serve every tenant, so one snippet covers all.
(cf_origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		# Authenticated Origin Pulls, CUSTOM cert. This is the control that
		# actually closes the "any Cloudflare customer can reach your origin"
		# bypass — Caddy rejects any TLS client that doesn't present a cert
		# chaining to OUR uploaded CA. The one-click AOP toggle uses a
		# Cloudflare-wide cert and does NOT do this; we require our own.
		client_auth {
			mode require_and_verify
			# Caddy 2.8+ syntax:
			trust_pool file {
				pem_file /etc/caddy/certs/cloudflare-aop-ca.pem
			}
			# Caddy 2.7 and earlier used instead:
			#   trusted_ca_cert_file /etc/caddy/certs/cloudflare-aop-ca.pem
		}
	}

	# Access log carrying the REAL client IP (client_ip is populated from
	# CF-Connecting-IP because of trusted_proxies above). fail2ban reads this.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep  5
		}
		format json
	}
}
