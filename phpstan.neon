includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - tests
    ignoreErrors:
        # Filament uses __get magic method for $this->form
        - '#Access to an undefined property .+::\$form#'
        # Pest uses $this bindings in beforeEach/test closures
        -
            identifier: property.notFound
            message: '#Access to an undefined property Pest\\PendingCalls\\TestCall::\$#'
        -
            identifier: method.notFound
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'
        -
            identifier: variable.undefined
            message: '#Undefined variable: \$this#'
            reportUnmatched: false
        # Mockery mocks are typed as MockInterface, so expectation chains and
        # mocks passed where an interface is expected never narrow. Ignored by
        # pattern rather than baselined: the counts drift every time a test is added.
        -
            identifier: method.notFound
            message: '#Call to an undefined method Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage::#'
            path: tests/*
            reportUnmatched: false
        -
            identifier: argument.type
            message: '#Mockery\\MockInterface given\.$#'
            path: tests/*
            reportUnmatched: false
