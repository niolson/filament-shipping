<?php

namespace Database\Seeders;

use App\Models\Carrier;
use App\Models\CarrierAccount;
use App\Models\CarrierAccountScope;
use Illuminate\Database\Seeder;

/**
 * Local settings seeder — NOT committed to version control.
 *
 * Copy this file to LocalSettingsSeeder.php and fill in your values.
 * Run with: php artisan db:seed --class=LocalSettingsSeeder
 * Or it runs automatically after SettingsSeeder during migrate:fresh --seed.
 *
 * Carrier and import credentials now live on the CarrierAccount and DataSource
 * models (not the settings table). The ship-from / return address lives on
 * Location and Client. This template shows how to provision a local USPS
 * CarrierAccount with a global scope so rates, labels, and address validation
 * resolve credentials the same way production does.
 */
class LocalSettingsSeeder extends Seeder
{
    public function run(): void
    {
        $uspsCarrierId = Carrier::where('name', 'USPS')->value('id');

        if ($uspsCarrierId) {
            $account = CarrierAccount::updateOrCreate(
                ['carrier_id' => $uspsCarrierId, 'name' => 'USPS (local)'],
                [
                    'active' => true,
                    // Non-secret credentials (crid/mid/eps_account)
                    'credentials' => [
                        'crid' => '',
                        'mid' => '',
                    ],
                    // Encrypted secrets (client_id/client_secret)
                    'secret_credentials' => [
                        'client_id' => '',
                        'client_secret' => '',
                    ],
                ],
            );

            // Global scope (no location/client) so resolveForShipment() finds it.
            CarrierAccountScope::firstOrCreate([
                'carrier_account_id' => $account->id,
                'location_id' => null,
                'client_id' => null,
            ]);
        }

        // For Shopify/Amazon imports, create a DataSource record instead, e.g.:
        //
        // DataSource::updateOrCreate(
        //     ['driver' => \App\Services\ShipmentImport\Sources\ShopifySource::class],
        //     [
        //         'name' => 'Shopify (local)',
        //         'active' => true,
        //         'settings' => ['channel_name' => 'Shopify', 'shop_domain' => 'your-shop.myshopify.com'],
        //         'secret_settings' => ['client_id' => '', 'client_secret' => '', 'access_token' => ''],
        //     ],
        // );
    }
}
